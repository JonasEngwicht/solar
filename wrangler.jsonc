{
  // Cloudflare Worker "solar": redirects www to the bare domain and serves the static site in ./public
  "name": "solar",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "austintexassolar.com", "custom_domain": true },
    { "pattern": "www.austintexassolar.com", "custom_domain": true }
  ]
}
